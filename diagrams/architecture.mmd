flowchart TB
    USER["用户 / 上层业务系统"]

    subgraph CLOUD["云端"]
        subgraph GLOBAL["可选：Global Master / Fleet Control Plane"]
            GM["Global Master<br/>多机器人任务分配"]
            REG["Robot Registry<br/>能力、在线状态、位置"]
            GMEM["Global Memory<br/>全局任务与跨机器人状态"]

            GM <--> REG
            GM <--> GMEM
        end

        subgraph MODEL["Sys2 Model Service"]
            ROUTER["Model Router<br/>Planner / Critic / VQA"]
            VLM["VLM / LLM / World Model"]
            SERVE["Model Serving<br/>OpenAI API / HTTP / gRPC<br/>可使用 FlagScale"]

            ROUTER --> VLM
            VLM --- SERVE
        end
    end

    subgraph EDGE["单机器人边缘端"]
        GATEWAY["Robot Control Plane Interface<br/>注册 · 接收任务 · 心跳<br/>取消 · 状态 · 结果上报"]

        subgraph HARNESS["System 2 Harness"]
            TM["Task Manager<br/>任务生命周期与状态机"]
            ORCH["Orchestrator<br/>主调度循环"]
            CTX["Context / Memory<br/>目标、计划、历史、失败信息"]
            PLAN["Planner Client<br/>Prompt组装与结果解析"]
            MON["Monitor / Critic<br/>成功、失败、超时、异常"]
            SCH["Policy / Skill Scheduler<br/>选择技能与执行策略"]

            TM --> ORCH
            ORCH <--> CTX
            ORCH <--> PLAN
            ORCH <--> MON
            ORCH --> SCH
        end

        S1["System 1 Policy Serving<br/>VLA / WAM / 专用 Policy<br/>Observation + Subtask → Action Chunk"]

        RB["RobotBackend<br/>统一真机与仿真接口"]

        SAFE["Local Safety Supervisor<br/>限位 · 碰撞 · 超时<br/>急停 · 网络失联保护"]
    end

    subgraph BACKENDS["RobotBackend 实现层"]
        ROSBACK["ROS2Backend"]
        SDKBACK["DirectSDKBackend"]
        SIMBACK["SimulatorBackend"]
    end

    subgraph ROS["ROS 2 层"]
        ROSAPI["Topic / Service / Action<br/>TF2 · ros2_control"]
        DRIVER["Robot Driver / Adapter"]
    end

    subgraph EXECUTION["环境与物理执行层"]
        SDK["厂商 SDK / 私有协议"]
        HW["真实机器人<br/>相机 · 机械臂 · 夹爪 · 底盘"]
        SIM["CALVIN / LIBERO<br/>Isaac Sim / Gazebo"]
    end

    USER -->|"直接下发单机任务"| GATEWAY
    USER -. "未来：全局任务" .-> GM

    GM -. "TaskEnvelope" .-> GATEWAY
    GATEWAY -. "注册、心跳、状态、结果" .-> GM
    GATEWAY --> TM

    PLAN <-->|"Plan / Replan / Critic 请求"| SERVE

    SCH -->|"current_subtask＋观测"| S1
    RB -->|"图像＋本体状态"| S1
    S1 -->|"action chunk"| RB

    ORCH -->|"observe / execute / cancel / reset"| RB
    RB -->|"observation / feedback / result"| ORCH
    MON -->|"continue / success / failure / replan"| ORCH

    RB --> SAFE
    SAFE --> ROSBACK
    SAFE --> SDKBACK
    SAFE --> SIMBACK

    RB --> ROSBACK
    RB --> SDKBACK
    RB --> SIMBACK

    ROSBACK <--> ROSAPI
    ROSAPI <--> DRIVER
    DRIVER <--> SDK
    SDKBACK <--> SDK
    SDK <--> HW
    SIMBACK <--> SIM
