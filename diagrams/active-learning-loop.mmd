%%{init: {"themeVariables": {"fontSize": "18px"}, "flowchart": {"nodeSpacing": 36, "rankSpacing": 52, "curve": "basis", "wrappingWidth": 460, "padding": 20}}}%%
flowchart TB
    POOL["未标注候选池"] --> A
    SEED["已标注种子集<br/>少量、可靠"] --> C
    BUDGET["预算与停止准则<br/>成本 · 轮数 · 目标"] --> A

    A["① 选择 · Select<br/>打分器：不确定性 / 分歧 / 代表性<br/>批量选择：冗余 / 覆盖 / 成本"]
    B["② 标注 · Annotate<br/>Oracle：人工 / 专家 / LLM<br/>质检：一致性 / 噪声 / 复核"]
    C["③ 入库与重训 · Retrain<br/>已标注集：去重 / 来源 / 版本<br/>模型：全量重训 / 增量微调"]
    D["④ 评估与决策 · Evaluate<br/>固定测试集 · 总体与分片指标<br/>学习曲线 · 随机基线 · 成本归一"]

    A --> B
    B --> C
    C --> D
    D -->|"未达目标且预算未尽：下一轮"| A
    D -->|"达到目标 / 收益不足 / 预算耗尽"| OUT["交付<br/>模型 · 标注集 · 成本账"]

    TEST["固定测试集<br/>与选择隔离"] -.-> D
    MON["监控<br/>校准 · 漂移 · 先验"] -.-> A
    MON -.-> C

    classDef stage fill:#fff,stroke:#171817,stroke-width:1.5px;
    classDef stop fill:#fff,stroke:#e85434,stroke-width:2px;
    class A,B,C,D stage;
    class OUT stop;
